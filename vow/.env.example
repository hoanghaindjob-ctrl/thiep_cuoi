# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env* đã nằm trong .gitignore.

# ── Mật khẩu trang quản lý ────────────────────────────────────────────────
# Bắt buộc. Chưa đặt thì / và /guests bị chặn hoàn toàn (trả 503).
# Thiệp của khách tại /i/<slug>/<token> vẫn mở tự do.
STUDIO_PASSWORD=doi-mat-khau-nay

# ── Supabase ──────────────────────────────────────────────────────────────
# Lấy ở Supabase → Project Settings → API.
# Dùng SERVICE ROLE key, không phải anon key: mọi truy vấn đều chạy ở máy chủ,
# và schema bật RLS mà không tạo policy nào, nên anon key không đọc được gì.
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ cho key này.
#
# Bỏ trống cả hai dòng dưới thì ứng dụng chạy bằng dữ liệu mẫu trong bộ nhớ
# máy chủ — tiện để phát triển, nhưng mất hết khi khởi động lại.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
